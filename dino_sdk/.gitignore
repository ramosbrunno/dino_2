# Dino SDK - .gitignore

# Build directories
build/
*.egg-info/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Backup and temporary
backup_*/
temp_*/
*.tmp
*.bak

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation builds
docs/_build/
